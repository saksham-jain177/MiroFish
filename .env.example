# LLM API Configuration (OpenAI SDK compatible — Ollama, vLLM, etc.)
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3

# Zep Cloud (GraphRAG memory — https://app.getzep.com/)
ZEP_API_KEY=your_zep_api_key_here

# Synthetica Engine Tuning (optional — all have sane defaults in config.py)
# SYNTHETICA_EVAL_CADENCE=3
# SYNTHETICA_LLM_TIMEOUT=15
# SYNTHETICA_BATCH_SIZE=1
# SYNTHETICA_MAX_CONTEXT=4096

# Trust Resource System
# SYNTHETICA_TRUST_INITIAL=100
# SYNTHETICA_TRUST_COOP_REGEN=5
# SYNTHETICA_TRUST_BETRAY_DAMAGE=15
# SYNTHETICA_TRUST_BONUS_THRESHOLD=70
# SYNTHETICA_TRUST_PENALTY_THRESHOLD=30

# Event Injector Frequency
# SYNTHETICA_EVENT_FREQ_MIN=8
# SYNTHETICA_EVENT_FREQ_MAX=12

# Barrier Maintenance Cost
# SYNTHETICA_BARRIER_MAINT=5

# Evaluator Scoring Priors
# SYNTH_SCORE_DESP=-0.15
# SYNTH_SCORE_ABUSE=0.20
# SYNTH_SCORE_REPEAT=0.20
# SYNTH_SCORE_ALTRUISM=-0.15
